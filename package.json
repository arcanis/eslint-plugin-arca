{
  "name": "eslint-plugin-arca",
  "version": "0.16.0",
  "description": "A plugin to make Maël happy",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin"
  ],
  "workspaces": [
    "tests/workspace"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcanis/eslint-plugin-arca.git"
  },
  "author": "Maël Nison",
  "main": "sources/index.ts",
  "scripts": {
    "prepack": "rm -rf lib && rollup -c",
    "postpack": "rm -rf lib",
    "_test": "yarn mocha --require $(node -p 'require.resolve(\"ts-node/register/transpile-only\")') --reporter dot",
    "test": "yarn _test **/*.test.ts",
    "preversion": "npm test",
    "postversion": "git push && git push --tags"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/eslint": "^9.6.1",
    "@types/estree": "^1.0.0",
    "@types/estree-jsx": "^1.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-arca": "link:./",
    "mocha": "^10.0.0",
    "rollup": "^4.0.0",
    "ts-node": "^10.0.0",
    "tslib": "^2.3.1",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "eslint": ">=10.0.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "files": [
    "lib"
  ],
  "publishConfig": {
    "main": "lib/index.js"
  },
  "license": "ISC",
  "packageManager": "yarn@3.8.7"
}
